# Copie este arquivo para .env e preencha SOMENTE com credenciais OAuth reais.
# Nunca versione o arquivo .env e nunca use senha de e-mail nestes campos.
SPRING_PROFILES_ACTIVE=oauth

# Google OAuth 2.0 — use o Client ID/Client Secret de um cliente Web no Google Auth Platform.
# O Client ID normalmente termina com .apps.googleusercontent.com.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# GitHub OAuth App — use o Client ID/Client Secret gerados em Developer settings > OAuth Apps.
# Não use seu nome de usuário ou senha do GitHub.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Callback do frontend após o backend emitir o JWT do CloudTask.
APP_OAUTH_FRONTEND_REDIRECT=http://localhost:5173
